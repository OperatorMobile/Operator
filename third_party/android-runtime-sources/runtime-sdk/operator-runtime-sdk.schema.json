{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://illumination.dev/operator/android-runtime-sdk.schema.json",
  "title": "Operator Android Runtime SDK Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifact",
    "profile",
    "version",
    "appId",
    "abi",
    "androidApi",
    "androidTarget",
    "prefix",
    "prefixRelative",
    "packages",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "artifact": {
      "type": "string",
      "pattern": "^operator-android-runtime-sdk-[A-Za-z0-9._-]+-[A-Za-z0-9._-]+-[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+-[A-Za-z0-9_-]+-api[0-9]+\\.tar\\.zst$"
    },
    "profile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "appId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
    },
    "abi": {
      "type": "string",
      "enum": ["arm64-v8a", "x86_64"]
    },
    "androidApi": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "androidTarget": {
      "type": "string",
      "enum": ["aarch64-linux-android", "x86_64-linux-android"]
    },
    "prefix": {
      "type": "string",
      "pattern": "^/data/data/[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+/files/tools/toolchain/usr$"
    },
    "prefixRelative": {
      "type": "string",
      "const": "usr"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9+._-]+$"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "repo", "ref", "commit", "license"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "license": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
